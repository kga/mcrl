checkout 1799998100-1799999900 logs=2 traces=1 errors=
denied 1799998100-1799999900 logs=- traces=- errors=logs,traces
-- want-changed.txt --
alDISK00002 WARNING 1799999500 1799999950
alDISK00001 CRITICAL 1799999400 1799999400
alDISK00003 CRITICAL 1799999000 1799999000
-- want-changed-next.txt --
mcrl metric get --host id:hostWEB0002 --name filesystem.root.size --since @1799999050 --until @1800000000
mcrl metric get --host id:hostWEB0002 --name filesystem.root.used --since @1799999050 --until @1800000000
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.size --since @1799999050 --until @1800000000
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.used --since @1799999050 --until @1800000000
mcrl metric get --host id:hostWEB0002 --name filesystem.root.size --since 15m
mcrl metric get --host id:hostWEB0002 --name filesystem.root.used --since 15m
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.size --since 15m
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.used --since 15m
