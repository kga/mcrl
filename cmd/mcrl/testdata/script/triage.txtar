host hostMAC0001: 8 filesystems; only the 5 with the highest usage are shown, left out: disk1s3 (20.0% now), disk1s1 (10.0% now), recovery (5.0% now); 6 filesystems without a current value were not considered
-- want-mac-next.txt --
mcrl metric get --host id:hostMAC0001 --name filesystem.zzdata.size --since @1799987700
mcrl metric get --host id:hostMAC0001 --name filesystem.zzdata.used --since @1799987700
mcrl metric get --host id:hostMAC0001 --name filesystem.tmp.size --since @1799987700
mcrl metric get --host id:hostMAC0001 --name filesystem.tmp.used --since @1799987700
-- want-mac2-errors.txt --
host hostMAC0002: 8 filesystems; only the 5 with the highest usage are shown, left out: disk1s3 (peak 20.0%), disk1s1 (peak 10.0%), recovery (peak 5.0%)
-- want-mac2-next.txt --
mcrl metric get --host id:hostMAC0002 --name filesystem.zzdata.size --since @1799987700
mcrl metric get --host id:hostMAC0002 --name filesystem.zzdata.used --since @1799987700
mcrl metric get --host id:hostMAC0002 --name filesystem.tmp.size --since @1799987700
mcrl metric get --host id:hostMAC0002 --name filesystem.tmp.used --since @1799987700
