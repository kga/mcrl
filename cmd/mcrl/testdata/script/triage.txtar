env MACKEREL_APIKEY=triage-key

# 監視ごとにまとめ、重い状態 → 新しい順に並べる。上位 --max-groups 件だけ context を持つ
exec mcrl triage --now @1800000000 --jq '.summary'
stdout '^\{"alerts":11,"critical":4,"groups":8,"open":11,"unknown":0,"warning":7\}$'
rm $WORK/requests.log
exec mcrl triage --now @1800000000 --jq '.groups[] | "\(.status) \(.monitor.id) \(.alerts | length) \(.context != null) \([.alerts[].id] | join(","))"'
cmp stdout want-groups.txt
grep '^0$' $WORK/exitcode
# 一覧は 1 回ずつ。ログ・トレースは --otel-service がなければ取らない
grep -count=1 'GET /api/v0/monitors$' $WORK/requests.log
grep -count=1 'GET /api/v0/hosts\?status=working&status=standby&status=maintenance&status=poweroff$' $WORK/requests.log
grep -count=1 'GET /api/v0/downtimes$' $WORK/requests.log
grep -count=1 'GET /api/v0/tsdb/latest\?hostId=hostOFF0001&name=loadavg5&name=cpu.user.percentage&name=memory.used$' $WORK/requests.log
grep -count=1 'GET /api/v0/hosts/hostRETIRED$' $WORK/requests.log
! grep 'POST|PUT|DELETE' $WORK/requests.log
# 範囲外のグループ（swap）の周辺情報は取らない
! grep 'hostWEB0002/metrics\?.*swap' $WORK/requests.log

# check 監視のアラートは GET /monitors にないので、ID で引いて名前を付ける。グループごとに 1 回
rm $WORK/requests.log
exec mcrl triage --now @1800000000 --jq '.groups[] | select(.alerts[0].type == "check") | .monitor | tojson'
cmp stdout want-checks.txt
grep -count=1 'GET /api/v0/monitoring/checks/chkPING0001$' $WORK/requests.log
grep -count=1 'GET /api/v0/monitoring/checks/chkGONE0001$' $WORK/requests.log
exec mcrl triage --now @1800000000 --jq '.groups[] | select(.monitor.id == "chkPING0001") | .errors | length'
stdout '^0$'
exec mcrl triage --now @1800000000 --jq '[.. | strings | select(. == "null")] | length'
stdout '^0$'

# 注記
exec mcrl triage --now @1800000000 --jq '.groups[] | "\(.monitor.id) [\([.notes[].kind] | join(","))]"'
cmp stdout want-notes.txt
exec mcrl triage --now @1800000000 --jq '.groups[0].notes[1].message'
stdout '^the host "off-1" last sent metrics at 2027-01-15T07:54:00Z, 1m before the alert opened$'
# ダウンタイム中は新しいアラートが作られないので、今有効なダウンタイムはアラートの後に始まったとみなす
exec mcrl triage --now @1800000000 --jq '.groups[1].notes[] | select(.kind == "in-downtime") | .message'
stdout '^the downtime "web maintenance" is in effect now and covers this monitor; downtimes stop new alerts, so it most likely started after the alert opened'
exec mcrl triage --now @1800000000 --jq '.groups[0].alerts[0].host'
stdout '^\{"id":"hostOFF0001","isRetired":false,"lastMetricAt":1799999640,"name":"off-1","roles":\[\],"status":"poweroff"\}$'

# 範囲は最も早いアラートの前後 --window（今を超えない）
exec mcrl triage --now @1800000000 --jq '.groups[2].context.range, .groups[0].context.range'
stdout '^\{"from":1799998100,"to":1799999900\}$'
stdout '^\{"from":1799998800,"to":1800000000\}$'

# 割合監視は元のメトリクスを取る。disk% は metric-names から filesystem.*.used / size を探す
exec mcrl triage --now @1800000000 --max-groups 6 --jq '.groups[] | .monitor.metric as $m | .context.metrics[]? | "\($m) \(.hostId // .service) \(.name)"'
cmp stdout want-metrics.txt
grep 'GET /api/v0/hosts/hostWEB0002/metrics\?from=1799998200&name=memory.swap_used&to=1800000000$' $WORK/requests.log
grep 'GET /api/v0/hosts/hostWEB0002/metrics\?from=1799998200&name=memory.swap_free&to=1800000000$' $WORK/requests.log
! grep 'name=disk%|name=cpu%|name=swap%|name=container' $WORK/requests.log
exec mcrl triage --now @1800000000 --jq '.groups[1].alerts[0].host.cpuCount'
stdout '^2$'

# 一部の取得の失敗は errors に入り、終了コードは 0。container-*% は元のメトリクスが分からない
exec mcrl triage --now @1800000000 --jq '.groups[] | .monitor.id as $id | .errors[] | "\($id) \(.source): \(.message)"'
cmp stdout want-errors.txt
grep '^0$' $WORK/exitcode

# value は直近の状態変化の時点の値。context は最初の openedAt の前後なので、
# 範囲外で変わったアラートには statusChangedAt と status-changed の注記、その前後を読む next が付く
exec mcrl triage --now @1800000000 --jq '.groups[2].alerts[] | "\(.id) \(.status) \(.openedAt) \(.statusChangedAt)"'
cmp stdout want-changed.txt
exec mcrl triage --now @1800000000 --jq '.groups[2].notes[] | select(.kind == "status-changed") | "\(.message) \(.resource.type) \(.resource.id)"'
stdout '^the alert "alDISK00002" changed to WARNING at 2027-01-15T07:59:10Z, 7m after it opened, outside the context range alert alDISK00002$'
exec mcrl triage --now @1800000000 --jq '.groups[2].next[] | select(contains("--until") or contains("--since 15m"))'
cmp stdout want-changed-next.txt
# 経過が読めないアラートは statusChangedAt を持たず、注記も出さない（context は変わらない）
exec mcrl triage --now @1800000000 --jq '.groups[4].alerts[0] | has("statusChangedAt")'
stdout '^false$'
# 詳細グループのアラートごとに経過を 1 回読む。詳細でないグループは読まない
rm $WORK/requests.log
exec mcrl triage --now @1800000000
grep -count=1 'GET /api/v0/alerts/alDISK00002/logs\?limit=100$' $WORK/requests.log
grep -count=1 'GET /api/v0/alerts/alCONN00001/logs\?limit=100$' $WORK/requests.log
! grep 'alSWAP00001/logs' $WORK/requests.log
# 経過を読むのは --max-hosts 件のアラートだけ（新しい順）。残りは statusChangedAt も注記も持たない
rm $WORK/requests.log
exec mcrl triage --now @1800000000 --max-hosts 2 --jq '.groups[2] | "\([.alerts[] | has("statusChangedAt")] | map(tostring) | join(",")) \([.notes[].kind] | index("status-changed") != null)"'
stdout '^true,true,false true$'
grep -count=1 'alDISK00002/logs' $WORK/requests.log
grep -count=1 'alDISK00001/logs' $WORK/requests.log
! grep 'alDISK00003/logs' $WORK/requests.log
rm $WORK/requests.log
exec mcrl triage --now @1800000000 --max-hosts 1 --jq '.groups[2] | "\([.alerts[] | has("statusChangedAt")] | map(tostring) | join(","))"'
stdout '^true,false,false$'
! grep 'alDISK00001/logs|alDISK00003/logs' $WORK/requests.log
# アラート ID を指定しないときは logs を出力しない
exec mcrl triage --now @1800000000 --jq '[.groups[].alerts[] | has("logs")] | any'
stdout '^false$'

# 他の監視・アノテーション・ダウンタイム
exec mcrl triage --now @1800000000 --jq '.groups[2].context.otherMonitors[] | "\(.hostId) \(.name) \(.status)"'
cmp stdout want-others.txt
exec mcrl triage --now @1800000000 --jq '.groups[2].context | [.annotations[].id, .downtimes[].id] | join(",")'
stdout '^anWEB000001,dtWEB000001$'
exec mcrl triage --now @1800000000 --jq '.groups[2].next[]'
cmp stdout want-next.txt

# --max-groups / --max-hosts
rm $WORK/requests.log
exec mcrl triage --now @1800000000 --max-groups 3 --max-hosts 1 --jq '[.groups[] | .context != null] | map(tostring) | join(",")'
stdout '^true,true,true,false,false,false,false,false$'
exec mcrl triage --now @1800000000 --max-groups 3 --max-hosts 1 --jq '[.groups[2].context.metrics[].hostId] | unique | join(",")'
stdout '^hostWEB0002$'
! grep 'hostWEB0003/(metrics|monitored-statuses)' $WORK/requests.log
! grep 'hostRETIRED' $WORK/requests.log
exec mcrl triage --now @1800000000 --max-groups 3 --jq '.groups[3] | [.notes[].kind, .next[]] | join(",")'
stdout '^mcrl triage --monitor id:monCTR00001$'

# 絞り込み
exec mcrl triage --now @1800000000 --status warning --jq '[.groups[].monitor.id] | join(",")'
stdout '^monCTR00001,monDISK0001,monSVC00001,monSWAP0001,chkPING0001,chkGONE0001$'
exec mcrl triage --now @1800000000 --host web-1 --jq '[.groups[].alerts[].id] | join(",")'
stdout '^alCPU000001,alDISK00001$'
exec mcrl triage --now @1800000000 --service web --jq '[.groups[].monitor.id] | join(",")'
stdout '^monCPU00001,monDISK0001,monSVC00001,monSWAP0001$'
exec mcrl triage --now @1800000000 --role web:app --monitor monDISK0001 --jq '.summary.alerts'
stdout '^3$'

# --skip / --only: 取らない情報は context から消え、リクエストもしない
rm $WORK/requests.log
exec mcrl triage --now @1800000000 --skip metrics,annotations --jq '.groups[2].context | keys | join(",")'
stdout '^downtimes,otherMonitors,range$'
! grep '/metrics|/metric-names|graph-annotations' $WORK/requests.log
rm $WORK/requests.log
exec mcrl triage --now @1800000000 --only downtimes --jq '.groups[2].context | keys | join(",")'
stdout '^downtimes,range$'
! grep 'monitored-statuses|/metrics' $WORK/requests.log

# --otel-service: ログ・トレースはグループとは別に、指定したサービスだけ取る
rm $WORK/requests.log
exec mcrl triage --now @1800000000 --otel-service checkout,denied --max-samples 2 --jq '.otel[] | "\(.serviceName) \(.range.from)-\(.range.to) logs=\(if has("logs") then .logs | length else "-" end) traces=\(if has("traces") then .traces | length else "-" end) errors=\([.errors[].source] | join(","))"'
cmp stdout want-otel.txt
grep '^0$' $WORK/exitcode
grep '"serviceName":"checkout","severities":\["ERROR","FATAL"\],"to":1799999900' $WORK/requests.log
grep '"order":\{"column":"LATENCY","direction":"DESC"\},"page":1,"perPage":2,"serviceName":"checkout","statusCode":"ERROR","to":1799999900' $WORK/requests.log
exec mcrl triage --now @1800000000 --otel-service checkout --jq '.otel[0].logs[] | "\(.truncated) \(.body | length)"'
stdout '^true 2000$'
stdout '^false 5$'
exec mcrl triage --now @1800000000 --otel-service checkout --jq '.otel[0].next[]'
stdout '^mcrl log search --service checkout --since @1799998100 --until @1799999900 --severity error\+$'
stdout '^mcrl trace list --service checkout --since @1799998100 --until @1799999900 --status error --sort latency$'
# トレースは 30 分まで。--window を広げると errors に入る
exec mcrl triage --now @1800000000 --otel-service checkout --window 20m --skip logs --jq '.otel[0].errors[].message'
stdout '30 minutes'

# アラート ID を指定すると、そのアラートだけを経過（logs）つきで
rm $WORK/requests.log
exec mcrl triage --now @1800000000 alDISK00001 --jq '.groups[0] | "\(.alerts | length) \(.alerts[0].logs[0].id) \(.next[0])"'
stdout '^1 log1 mcrl metric get --host id:hostWEB0001 --name filesystem.root.size --since @1799987700$'
grep 'GET /api/v0/alerts/alDISK00001/logs' $WORK/requests.log
! grep 'GET /api/v0/alerts$' $WORK/requests.log

# disk% はファイルシステムを used / size の組として扱う。範囲に点がないものは捨て、
# 使用率の高い順に 5 つ。外したものは errors に使用率つきで書く。next は組で出す。
# 順位は /tsdb/latest の現在値で付けるので、点を読むのは上位の 5 組（10 系列）だけ
rm $WORK/requests.log
exec mcrl triage --now @1800000000 alMAC000001 --jq '.groups[0].context.metrics[] | .name'
cmp stdout want-mac-metrics.txt
grep -count=1 'GET /api/v0/hosts/hostMAC0001/metric-names$' $WORK/requests.log
grep -count=1 'GET /api/v0/tsdb/latest\?hostId=hostMAC0001&name=filesystem.data1.used' $WORK/requests.log
grep -count=10 'GET /api/v0/hosts/hostMAC0001/metrics\?' $WORK/requests.log
exec mcrl triage --now @1800000000 alMAC000001 --jq '.groups[0].errors[].message'
cmp stdout want-mac-errors.txt
exec mcrl triage --now @1800000000 alMAC000001 --jq '.groups[0].next[] | select(startswith("mcrl metric get"))'
cmp stdout want-mac-next.txt

# /tsdb/latest が null を返すホスト（しばらくメトリクスを送っていない）は、
# 範囲内の点の最大使用率で順位を付ける。同じ結果で、errors の使用率は peak
rm $WORK/requests.log
exec mcrl triage --now @1800000000 alMAC000002 --jq '.groups[0].context.metrics[] | .name'
cmp stdout want-mac-metrics.txt
grep -count=1 'GET /api/v0/tsdb/latest\?hostId=hostMAC0002&name=filesystem.data1.used' $WORK/requests.log
grep -count=28 'GET /api/v0/hosts/hostMAC0002/metrics\?' $WORK/requests.log
exec mcrl triage --now @1800000000 alMAC000002 --jq '.groups[0].errors[].message'
cmp stdout want-mac2-errors.txt
exec mcrl triage --now @1800000000 alMAC000002 --jq '.groups[0].next[] | select(startswith("mcrl metric get"))'
cmp stdout want-mac2-next.txt

# 使い方の誤り
! exec mcrl triage --skip nope
grep '^2$' $WORK/exitcode
stderr 'unknown source \\"nope\\"'
! exec mcrl triage --skip logs --only traces
grep '^2$' $WORK/exitcode
! exec mcrl triage --window 0
grep '^2$' $WORK/exitcode
! exec mcrl triage --status ok
grep '^2$' $WORK/exitcode
! exec mcrl triage --max-groups 0
grep '^2$' $WORK/exitcode
# /tsdb/latest が null を返したメトリクスだけ、アラートが開く前の 7 日間の時系列 API から最後の点を探す。
# /tsdb/latest に出てこないホスト（hostGHOST001）には何も聞かない
rm $WORK/requests.log
exec mcrl triage --now @1800000000 alCONN00002 alCONN00003 alCONN00004 --jq '.groups[0].alerts[] | "\(.id) \(.host.lastMetricAt)"'
cmp stdout want-slow.txt
grep -count=1 'GET /api/v0/tsdb/latest\?hostId=hostSLOW0001&hostId=hostNONE0001&hostId=hostGHOST001&name=loadavg5&name=cpu.user.percentage&name=memory.used$' $WORK/requests.log
! grep 'hostSLOW0001/metrics.*loadavg5' $WORK/requests.log
! grep 'hostGHOST001/metrics' $WORK/requests.log
grep -count=1 'GET /api/v0/hosts/hostSLOW0001/metrics\?from=1799394900&name=cpu.user.percentage&to=1800000000$' $WORK/requests.log
! grep 'hostSLOW0001/metrics.*memory.used' $WORK/requests.log
grep -count=3 'GET /api/v0/hosts/hostNONE0001/metrics' $WORK/requests.log
exec mcrl triage --now @1800000000 alCONN00002 alCONN00003 alCONN00004 --jq '.groups[0].notes[] | select(.kind == "metrics-stopped") | .message'
stdout -count=1 '^the host "slow-1" last sent metrics at 2027-01-15T05:13:20Z, 2h41m before the alert opened$'

# 時系列 API が失敗したホストは、ホストごとに errors へ 1 件。他のホストの lastMetricAt と注記は残る。
# 失敗したホストは lastMetricAt を持たない（null でもない）
exec mcrl triage --now @1800000000 alCONN00002 alCONN00005 --jq '[.groups[0].errors[] | select(.source == "hosts") | .message] | length'
stdout '^1$'
exec mcrl triage --now @1800000000 alCONN00002 alCONN00005 --jq '.groups[0].errors[] | select(.source == "hosts") | .message'
stdout 'last metric time of host hostFAIL0001: .*loadavg5'
exec mcrl triage --now @1800000000 alCONN00002 alCONN00005 --jq '.groups[0].alerts[] | "\(.id) \(.host | has("lastMetricAt")) \(.host.lastMetricAt)"'
cmp stdout want-fail.txt
exec mcrl triage --now @1800000000 alCONN00002 alCONN00005 --jq '.groups[0].notes[] | select(.kind == "metrics-stopped") | .resource.id'
stdout '^hostSLOW0001$'

# 範囲はアラートが開く 7 日前から今まで。アラートのあとにメトリクスが届いていたら、lastMetricAt はその時刻で、metrics-stopped は付かない
exec mcrl triage --now @1800000000 alCONN00006 --jq '.groups[0].alerts[0].host.lastMetricAt'
stdout '^1799999800$'
exec mcrl triage --now @1800000000 alCONN00006 --jq '[.groups[0].notes[].kind] | join(",")'
stdout '^host-not-working$'
grep -count=2 'GET /api/v0/hosts/hostLATE0001/metrics\?from=1799394900&name=loadavg5&to=1800000000$' $WORK/requests.log

! exec mcrl triage --role web
grep '^2$' $WORK/exitcode

-- want-fail.txt --
alCONN00002 true 1799990000
alCONN00005 false null
-- want-slow.txt --
alCONN00002 1799990000
alCONN00003 null
alCONN00004 null
-- want-groups.txt --
CRITICAL monCONN0001 1 true alCONN00001
CRITICAL monCPU00001 1 true alCPU000001
CRITICAL monDISK0001 3 true alDISK00002,alDISK00001,alDISK00003
WARNING monCTR00001 1 true alCTR000001
WARNING monSVC00001 1 true alSVC000001
WARNING monSWAP0001 1 false alSWAP00001
WARNING chkPING0001 2 false alCHK000001,alCHK000002
WARNING chkGONE0001 1 false alCHK000003
-- want-checks.txt --
{"id":"chkPING0001","name":"check-ping-sample","type":"check"}
{"id":"chkGONE0001","type":"check"}
-- want-notes.txt --
monCONN0001 [host-not-working,metrics-stopped]
monCPU00001 [monitor-muted,in-downtime,recent-annotation,other-monitors-failing]
monDISK0001 [in-downtime,status-changed,recent-annotation,many-hosts,other-monitors-failing,other-monitors-failing]
monCTR00001 [host-retired]
monSVC00001 [in-downtime,recent-annotation]
monSWAP0001 []
chkPING0001 []
chkGONE0001 []
-- want-metrics.txt --
cpu% hostWEB0001 cpu.idle.percentage
disk% hostWEB0002 filesystem.root.size
disk% hostWEB0002 filesystem.root.used
disk% hostWEB0002 filesystem.vdb.size
disk% hostWEB0002 filesystem.vdb.used
disk% hostWEB0001 filesystem.root.size
disk% hostWEB0001 filesystem.root.used
disk% hostWEB0001 filesystem.vdb.size
disk% hostWEB0001 filesystem.vdb.used
disk% hostWEB0003 filesystem.root.size
disk% hostWEB0003 filesystem.root.used
disk% hostWEB0003 filesystem.vdb.size
disk% hostWEB0003 filesystem.vdb.used
response.time web response.time
swap% hostWEB0002 memory.swap_free
swap% hostWEB0002 memory.swap_total
-- want-errors.txt --
monDISK0001 monitors: host hostWEB0003: Forbidden (HTTP 403 GET /api/v0/hosts/hostWEB0003/monitored-statuses)
monCTR00001 metrics: container-cpu% is a rate monitor whose source metrics are unknown, so no metric is shown; the alert's value has the rate
monSVC00001 alertLogs: alert alSVC000001: Forbidden (HTTP 403 GET /api/v0/alerts/alSVC000001/logs)
chkGONE0001 monitors: check chkGONE0001: Not found (HTTP 404 GET /api/v0/monitoring/checks/chkGONE0001)
-- want-others.txt --
hostWEB0002 swap WARNING
hostWEB0001 cpu high CRITICAL
-- want-next.txt --
mcrl alert logs alDISK00002
mcrl metric get --host id:hostWEB0002 --name filesystem.root.size --since @1799987300
mcrl metric get --host id:hostWEB0002 --name filesystem.root.used --since @1799987300
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.size --since @1799987300
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.used --since @1799987300
mcrl metric get --host id:hostWEB0002 --name filesystem.root.size --since @1799999050 --until @1800000000
mcrl metric get --host id:hostWEB0002 --name filesystem.root.used --since @1799999050 --until @1800000000
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.size --since @1799999050 --until @1800000000
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.used --since @1799999050 --until @1800000000
mcrl metric get --host id:hostWEB0002 --name filesystem.root.size --since 15m
mcrl metric get --host id:hostWEB0002 --name filesystem.root.used --since 15m
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.size --since 15m
mcrl metric get --host id:hostWEB0002 --name filesystem.vdb.used --since 15m
mcrl host monitor-status id:hostWEB0002 --expand
mcrl annotation list --service web --since @1799911700
