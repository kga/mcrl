# 終了コードとエラー出力（stderr が TTY でなければ 1 行の JSON）
env MACKEREL_APIKEY=good-key

! exec mcrl api /hosts/abcdefghijk
grep '^4$' $WORK/exitcode
stderr '^\{"error":\{"code":"not_found","message":"Host Not Found. \(HTTP 404 GET /api/v0/hosts/abcdefghijk\)","status":404\}\}$'

env MACKEREL_APIKEY=bad
! exec mcrl api /org
grep '^3$' $WORK/exitcode
env MACKEREL_APIKEY=good-key
stderr '"code":"unauthorized"'
stderr '"hint":"check the API key'

! exec mcrl api
grep '^2$' $WORK/exitcode
stderr '"code":"usage"'

! exec mcrl api /org --no-such-flag
grep '^2$' $WORK/exitcode

! exec mcrl no-such-command
grep '^2$' $WORK/exitcode

! exec mcrl api /org -o yaml
grep '^2$' $WORK/exitcode
stderr 'valid: json, jsonl'

! exec mcrl api /org --jq '.['
grep '^2$' $WORK/exitcode
stderr 'invalid --jq expression'

env MCRL_API_BASE=http://127.0.0.1:1
! exec mcrl api /org
grep '^7$' $WORK/exitcode
env MCRL_API_BASE=$SERVER
stderr '"code":"network"'

# --paginate は GET のみ
! exec mcrl api -X POST /alerts --paginate
grep '^2$' $WORK/exitcode

exec mcrl help exit-codes
stdout '130  interrupted'
